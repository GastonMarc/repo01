<?php
// Esta es la interfaz `EjemploInterface`
// La interfaz define la estructura básica que deben seguir las clases concretas que la implementen.

interface EjemploInterface {
    // Este método debe ser implementado para obtener un elemento.
    public function obtenerElemento();

    // Este método debe ser implementado para agregar un elemento.
    public function agregarElemento($elemento);

    // Este método debe ser implementado para eliminar un elemento.
    public function eliminarElemento($elemento);

    // Este método debe ser implementado para listar todos los elementos.
    public function listarElementos();
}

// Implementación de la interfaz `EjemploInterface` en una clase concreta.
class EjemploClase implements EjemploInterface {
    private $elementos = [];

    public function obtenerElemento() {
        // Lógica para obtener un elemento, posiblemente retornando el primer elemento de la lista.
        return $this->elementos[0] ?? null;
    }

    public function agregarElemento($elemento) {
        // Lógica para agregar un elemento al array de elementos.
        $this->elementos[] = $elemento;
    }

    public function eliminarElemento($elemento) {
        // Lógica para eliminar un elemento específico de la lista, si existe.
        $this->elementos = array_filter($this->elementos, function($e) use ($elemento) {
            return $e !== $elemento;
        });
    }

    public function listarElementos() {
        // Retorna todos los elementos en la lista.
        return $this->elementos;
    }
}
?>
